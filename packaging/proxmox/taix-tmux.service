# The tmux server TaiX drives, in its own unit so restarting the window
# (taix-host) never takes the terminals and agents with it.
[Unit]
Description=TaiX tmux server

[Service]
Type=forking
Environment=LANG=C.UTF-8 SHELL=/usr/bin/zsh HOME=/root
WorkingDirectory=/root
ExecStart=/usr/bin/tmux -L taix new-session -d -s taix -x 240 -y 60
ExecStop=/usr/bin/tmux -L taix kill-server
Restart=on-failure

[Install]
WantedBy=multi-user.target
